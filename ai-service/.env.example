# ─── FastAPI Unified Backend ───────────────────────────────────────────────────

# Server
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=INFO

# Deployment / CORS
FRONTEND_URL=http://localhost:3000

# Database (Supabase PostgreSQL)
DATABASE_URL=postgresql+psycopg2://postgres.xxxxxx:password@aws-0-region.pooler.supabase.com:6543/postgres
DIRECT_DATABASE_URL=postgresql+psycopg2://postgres.xxxxxx:password@aws-0-region.pooler.supabase.com:5432/postgres

# Supabase Auth / Storage (if using Supabase client directly)
SUPABASE_URL=https://xxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Cloudinary (Images)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Redis / Celery (Optional for background tasks)
REDIS_URL=redis://localhost:6379

# AI Models
CLIP_MODEL=ViT-B-32
SIMILARITY_THRESHOLD=0.85
CUDA_VISIBLE_DEVICES=0
