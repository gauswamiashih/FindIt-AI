# ─── Client ────────────────────────────────────────────────────────────────────
# The base URL of the FastAPI backend API
VITE_API_URL=https://your-backend-api-url.onrender.com/api/v1
# The URL for WebSocket connections (if using FastAPI WebSockets)
VITE_SOCKET_URL=wss://your-backend-api-url.onrender.com
# Application name
VITE_APP_NAME=FindIt
# The frontend URL (e.g. your Vercel deployment URL)
VITE_APP_URL=https://your-vercel-frontend-url.vercel.app
